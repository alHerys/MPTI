{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coldstart-kitchen",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
